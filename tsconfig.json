{
  "compilerOptions": {
      "rootDir": "src-ts",
      "outDir": "./lib-esm",
      "declarationDir": "./types",
      "composite": true,
      "tsBuildInfoFile": "./lib-esm/tsconfig.tsbuildinfo",
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable", "ES2022.Error"],
      "module": "esnext",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "sourceMap": true,
      "declaration": true,
      "declarationMap": true,
      "skipLibCheck": true,
      "strict": true,
      "noImplicitAny": false
  },
  "types": [],
  "include": [
      "src-ts/**/*"
  ],
  "references": [],
}